{
	"name": "zweefstats",
	"version": "1.4.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"build:server": "node build_server.js",
		"preview:server": "wrangler dev dist/index.mjs",
		"deploy:server": "wrangler publish",
		"proxy:server": "lcp --proxyUrl https://api.zweefstats.nl"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20230221.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.7",
		"@types/papaparse": "^5.5.2",
		"autoprefixer": "^10.4.13",
		"esbuild": "^0.28.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"lcp": "^1.1.0",
		"local-cors-proxy": "^1.1.0",
		"postcss": "^8.4.18",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.2.1",
		"tslib": "^2.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0",
		"wrangler": "^2.11.1"
	},
	"dependencies": {
		"daisyui": "^2.42.1",
		"marked": "^18.0.12",
		"papaparse": "^5.3.2"
	}
}
